---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PackCard from '../../components/PackCard.astro';
import { categories, fromPrice, type Category } from '../../data/cursos';
import { ars, waLink } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category: c } = Astro.props as { category: Category };
const from = fromPrice(c);
const others = categories.filter((o) => o.slug !== c.slug);
const waMsg = `Hola! Quiero información sobre el curso de ${c.navLabel}.`;
---

<Base
  title={`Curso de ${c.navLabel} en Hurlingham`}
  description={`${c.intro} ${from ? `Desde ${ars(from)}.` : ''}`}
  image={c.image}
  waMessage={waMsg}
>
  <section class="detail-hero">
    <img src={c.image} alt={c.imageAlt} width="1000" height="747" class="detail-hero__bg" fetchpriority="high" />
    <div class="detail-hero__shade" aria-hidden="true"></div>
    <div class="container detail-hero__inner">
      <nav class="crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a> <span>/</span> <a href="/cursos">Cursos</a> <span>/</span> <span aria-current="page">{c.navLabel}</span>
      </nav>
      <p class="eyebrow">{c.license}</p>
      <h1>{c.name}</h1>
      <p class="detail-hero__lead">{c.intro}</p>
      <div class="detail-hero__actions">
        <a href="#packs" class="btn btn--gold" id="detail-cta-packs">
          {from ? <>Ver packs desde {ars(from)}</> : 'Ver packs'}
        </a>
        <a href={waLink(waMsg)} target="_blank" rel="noopener" class="btn btn--ghost" id="detail-cta-wa">
          <Icon name="whatsapp" /> Consultar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container info">
      <div class="info__card reveal">
        <span class="info__icon"><Icon name="steering" size={26} /></span>
        <h2>Qué vas a aprender</h2>
        <ul class="check-list">{c.highlights.map((h) => <li>{h}</li>)}</ul>
      </div>
      <div class="info__card reveal">
        <span class="info__icon"><Icon name="book" size={26} /></span>
        <h2>Requisitos</h2>
        <ul class="check-list">{c.requirements.map((r) => <li>{r}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="packs" aria-labelledby="packs-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">Packs y precios</p>
        <h2 id="packs-title">Elegí el pack para tu nivel</h2>
        <p>¿No sabés cuál te conviene? Escribinos y te asesoramos sin compromiso.</p>
      </div>
      <div class="packs">
        {c.packs.map((p) => <PackCard pack={p} category={c} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="others-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">También enseñamos</p>
        <h2 id="others-title">Otros cursos</h2>
      </div>
      <div class="others">
        {
          others.map((o) => (
            <a href={`/cursos/${o.slug}`} class="other reveal">
              <img src={o.image} alt="" width="1000" height="747" loading="lazy" />
              <span>
                <strong>{o.navLabel}</strong>
                <small>{o.license}</small>
              </span>
              <Icon name="arrow" size={18} />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .detail-hero {
    position: relative;
    color: var(--white);
    isolation: isolate;
    overflow: hidden;
  }
  .detail-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .detail-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, hsl(355 70% 10% / 0.94) 0%, hsl(356 75% 18% / 0.8) 50%, hsl(356 75% 18% / 0.35) 100%);
  }
  .detail-hero__inner {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .crumbs {
    font-size: var(--fs-sm);
    color: hsl(0 0% 100% / 0.7);
    margin-bottom: 1rem;
  }
  .crumbs a:hover {
    color: var(--gold-400);
  }
  .crumbs span {
    margin-inline: 0.3rem;
  }
  .detail-hero h1 {
    font-size: var(--fs-4xl);
    max-width: 16ch;
  }
  .detail-hero__lead {
    max-width: 58ch;
    font-size: var(--fs-lg);
    color: hsl(0 0% 100% / 0.85);
  }
  .detail-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .info__card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    outline: 1px solid var(--line);
  }
  .info__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: var(--red-600);
    color: var(--white);
    box-shadow: var(--shadow-red);
  }
  .info__card h2 {
    font-size: var(--fs-2xl);
    margin-block: 1.25rem 1.25rem;
  }
  @media (max-width: 760px) {
    .info {
      grid-template-columns: 1fr;
    }
  }

  .packs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  .others {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .other {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    padding-right: 1.25rem;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    outline: 1px solid var(--line);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      opacity 0.8s var(--ease);
  }
  .other:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .other img {
    width: 76px;
    height: 58px;
    object-fit: cover;
    border-radius: 10px;
  }
  .other span {
    display: grid;
    flex: 1;
    line-height: 1.3;
  }
  .other small {
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .other svg {
    color: var(--red-600);
  }
</style>
