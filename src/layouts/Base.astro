---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../data/site';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  /** Mensaje precargado del botón flotante de WhatsApp. */
  waMessage?: string;
};

const {
  title,
  description = site.description,
  image = '/img/og.jpg',
  waMessage = site.whatsapp.defaultMessage,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} · Clases de manejo en Hurlingham`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DrivingSchool',
  name: site.name,
  image: ogImage,
  logo: new URL('/img/logo-512.webp', site.url).href,
  url: site.url,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  areaServed: ['Hurlingham', 'William C. Morris', 'Villa Tesei', 'Ituzaingó', 'Morón'],
  openingHours: site.hours.map((h) => h.schema).filter(Boolean),
  sameAs: Object.values(site.social).filter(Boolean),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#9c0f12" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />

    <a href={waLink(waMessage)} target="_blank" rel="noopener" class="wa-float" id="wa-float" aria-label="Escribinos por WhatsApp">
      <Icon name="whatsapp" size={30} />
      <span class="wa-float__label">¿Consultas? Escribinos</span>
    </a>

    <script>
      // Animaciones de entrada al hacer scroll
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>

    <style is:global>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -100px;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: var(--gold-400);
        color: var(--red-950);
        font-weight: 700;
        border-radius: 8px;
      }
      .skip-link:focus {
        top: 1rem;
      }
      .wa-float {
        position: fixed;
        right: clamp(1rem, 3vw, 1.75rem);
        bottom: clamp(1rem, 3vw, 1.75rem);
        z-index: 60;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        height: 60px;
        padding: 0 15px;
        border-radius: 999px;
        background: var(--wa);
        color: var(--white);
        box-shadow: 0 14px 30px -10px hsl(142 70% 25% / 0.7);
        transition:
          transform 0.3s var(--ease),
          box-shadow 0.3s;
      }
      .wa-float:hover {
        transform: translateY(-3px) scale(1.03);
      }
      .wa-float__label {
        max-width: 0;
        overflow: hidden;
        white-space: nowrap;
        font-weight: 600;
        font-size: var(--fs-sm);
        transition: max-width 0.4s var(--ease);
      }
      .wa-float:hover .wa-float__label {
        max-width: 200px;
        padding-right: 6px;
      }
    </style>
  </body>
</html>
