---
import Icon from './Icon.astro';
import { site, waLink } from '../data/site';
import { categories } from '../data/cursos';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div class="topbar">
  <div class="container topbar__inner">
    <a href={site.address.mapsUrl} target="_blank" rel="noopener" class="topbar__item">
      <Icon name="pin" size={15} />
      {site.address.street}, {site.address.locality}
    </a>
    <span class="topbar__item topbar__hours">
      <Icon name="clock" size={15} />
      Lun a vie 8–18 h · Sáb 9–13 h
    </span>
    <a href={site.google.reviewsUrl} target="_blank" rel="noopener" class="topbar__item topbar__rating">
      <span class="stars" aria-hidden="true">★★★★★</span>
      <strong>{site.google.rating.toString().replace('.', ',')}</strong> en Google · {site.google.reviews} reseñas
    </a>
  </div>
</div>

<header class="header textured" id="site-header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label="JV Autoescuela — inicio">
      <img src="/img/logo.webp" alt="" width="52" height="52" class="brand__logo" />
      <span class="brand__text">
        <span class="brand__name">JV<span>.</span> Autoescuela</span>
        <span class="brand__sub">Hurlingham</span>
      </span>
    </a>

    <nav class="nav" id="main-nav" aria-label="Principal">
      <ul class="nav__list">
        <li class="nav__item nav__item--has-menu">
          <a href="/cursos" class:list={['nav__link', { 'is-active': isActive('/cursos') }]} id="nav-cursos">
            Cursos
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </a>
          <div class="nav__menu">
            {
              categories.map((c) => (
                <a href={`/cursos/${c.slug}`} class="nav__menu-link">
                  <img src={c.image} alt="" width="56" height="42" loading="lazy" />
                  <span>
                    <strong>{c.navLabel}</strong>
                    <small>{c.license}</small>
                  </span>
                </a>
              ))
            }
          </div>
        </li>
        <li><a href="/#por-que-jv" class="nav__link">Por qué JV</a></li>
        <li><a href="/#preguntas" class="nav__link">Preguntas</a></li>
        <li><a href="/contacto" class:list={['nav__link', { 'is-active': isActive('/contacto') }]}>Contacto</a></li>
      </ul>
      <a href={waLink()} target="_blank" rel="noopener" class="btn btn--gold nav__cta" id="header-cta">
        <Icon name="whatsapp" />
        Inscribite
      </a>
    </nav>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="main-nav">
      <span class="visually-hidden">Abrir menú</span>
      <span class="icon-open"><Icon name="menu" /></span>
      <span class="icon-close"><Icon name="close" /></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const header = document.getElementById('site-header');
  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  header?.querySelectorAll('.nav a').forEach((a) =>
    a.addEventListener('click', () => {
      header.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }),
  );
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .topbar {
    background: var(--red-950);
    color: hsl(0 0% 100% / 0.78);
    font-size: var(--fs-xs);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    min-height: 38px;
  }
  .topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s;
  }
  a.topbar__item:hover {
    color: var(--white);
  }
  .topbar__rating {
    margin-left: auto;
  }
  .topbar__rating strong {
    color: var(--white);
  }
  .stars {
    color: var(--gold-400);
    letter-spacing: 1px;
  }
  @media (max-width: 860px) {
    .topbar__hours {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .topbar__inner > a:first-child {
      display: none;
    }
    .topbar__rating {
      margin-inline: auto;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--red-700);
    color: var(--white);
    isolation: isolate;
    transition: box-shadow 0.3s;
  }
  .header.is-scrolled {
    box-shadow: 0 10px 30px -12px hsl(355 70% 10% / 0.55);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 76px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand__logo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    box-shadow:
      0 0 0 2px hsl(47 90% 62% / 0.85),
      0 6px 16px -6px hsl(0 0% 0% / 0.5);
    transition: transform 0.5s var(--ease);
  }
  .brand:hover .brand__logo {
    transform: rotate(-8deg) scale(1.04);
  }
  .brand__text {
    display: grid;
    line-height: 1.1;
  }
  .brand__name {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  .brand__name span {
    color: var(--gold-400);
  }
  .brand__sub {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav__list {
    display: flex;
    gap: 0.25rem;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: var(--fs-sm);
    transition: background-color 0.2s;
  }
  .nav__link:hover,
  .nav__link.is-active {
    background: hsl(0 0% 100% / 0.12);
  }
  .nav__item--has-menu {
    position: relative;
  }
  .nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: 320px;
    padding: 0.5rem;
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease),
      visibility 0.2s;
  }
  .nav__menu::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  .nav__item--has-menu:hover .nav__menu,
  .nav__item--has-menu:focus-within .nav__menu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .nav__menu-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s;
  }
  .nav__menu-link:hover {
    background: var(--red-50);
  }
  .nav__menu-link img {
    width: 56px;
    height: 42px;
    object-fit: cover;
    border-radius: 6px;
  }
  .nav__menu-link span {
    display: grid;
    line-height: 1.25;
  }
  .nav__menu-link strong {
    font-size: var(--fs-sm);
  }
  .nav__menu-link small {
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .menu-toggle {
    display: none;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 12px;
    background: hsl(0 0% 100% / 0.12);
    color: var(--white);
    cursor: pointer;
    place-items: center;
  }
  .menu-toggle .icon-close {
    display: none;
  }
  .is-open .menu-toggle .icon-open {
    display: none;
  }
  .is-open .menu-toggle .icon-close {
    display: block;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: grid;
    }
    .nav {
      position: fixed;
      inset: 114px 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--red-800);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition:
        opacity 0.25s,
        transform 0.3s var(--ease),
        visibility 0.25s;
    }
    .is-scrolled .nav {
      inset-block-start: 76px;
    }
    .is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__list {
      flex-direction: column;
    }
    .nav__link {
      font-size: var(--fs-lg);
      padding: 0.85rem 1rem;
      width: 100%;
    }
    .nav__link svg {
      display: none;
    }
    .nav__menu {
      position: static;
      width: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      box-shadow: none;
      color: var(--white);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.25rem;
      padding: 0 0 0.5rem;
    }
    .nav__item--has-menu:hover .nav__menu,
    .nav__item--has-menu:focus-within .nav__menu {
      transform: none;
    }
    .nav__menu-link:hover {
      background: hsl(0 0% 100% / 0.08);
    }
    .nav__menu-link small {
      color: hsl(0 0% 100% / 0.6);
    }
    .nav__cta {
      min-height: 54px;
      font-size: var(--fs-base);
    }
  }
  @media (max-width: 600px) {
    .brand__logo {
      width: 44px;
      height: 44px;
    }
    .nav {
      inset-block-start: 114px;
    }
    .nav__menu {
      grid-template-columns: 1fr;
    }
  }
</style>
