---
type Props = { items: { q: string; a: string }[]; id?: string };
const { items, id = 'faq' } = Astro.props;
---

<div class="faq" id={id}>
  {
    items.map((item, i) => (
      <details class="faq__item" open={i === 0}>
        <summary>
          <span>{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__body">
          <div class="faq__inner">
            <p>{item.a}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.faq').forEach((faq) => {
    const items = Array.from(faq.querySelectorAll<HTMLDetailsElement>('.faq__item'));
    const closeItem = (el: HTMLDetailsElement) => {
      const body = el.querySelector<HTMLElement>('.faq__body');
      if (!body || !el.open) return;
      el.classList.add('is-closing');
      const anim = body.animate([{ height: `${body.offsetHeight}px` }, { height: '0px' }], {
        duration: 260,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
      anim.onfinish = () => {
        el.open = false;
        el.classList.remove('is-closing');
      };
    };
    const openItem = (el: HTMLDetailsElement) => {
      const body = el.querySelector<HTMLElement>('.faq__body');
      el.open = true;
      if (!body) return;
      const target = body.scrollHeight;
      body.animate([{ height: '0px' }, { height: `${target}px` }], {
        duration: 300,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      });
    };

    items.forEach((el) => {
      const summary = el.querySelector('summary');
      summary?.addEventListener('click', (e) => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        e.preventDefault();
        if (el.open && !el.classList.contains('is-closing')) {
          closeItem(el);
        } else {
          items.forEach((other) => {
            if (other !== el && other.open) closeItem(other);
          });
          openItem(el);
        }
      });
    });
  });
</script>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }
  .faq__item {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    outline: 1px solid var(--line);
    transition: box-shadow 0.25s;
  }
  .faq__item[open] {
    box-shadow: var(--shadow);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-lg);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--red-50);
    transition:
      background-color 0.25s,
      transform 0.35s var(--ease);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 12px;
    height: 2px;
    background: var(--red-600);
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: background-color 0.25s;
  }
  .faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .faq__item[open]:not(.is-closing) .faq__icon {
    background: var(--red-600);
    transform: rotate(45deg);
  }
  .faq__item[open]:not(.is-closing) .faq__icon::before,
  .faq__item[open]:not(.is-closing) .faq__icon::after {
    background: var(--white);
  }
  .faq__body {
    overflow: hidden;
  }
  .faq__inner p {
    padding: 0 1.4rem 1.3rem;
    color: var(--ink-2);
    max-width: 70ch;
  }
</style>
